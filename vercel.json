{
    "version": 2,
    "installCommand": "npm install && npm install --prefix frontend",
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 60,
                "memory": 3008,
                "nodeVersion": "20.x"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/server.js"
        }
    ]
}
